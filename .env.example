# Copy to .env. Leave a group empty to run that channel in preview mode.
PORT=3000
# Set HOST=0.0.0.0 to open the demo from another device on your network.
# Anyone on that network can then see the saved phone number and email.
HOST=

# Text messages (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=
